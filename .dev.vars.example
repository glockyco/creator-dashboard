ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
ACCESS_AUD=replace-with-access-application-aud
DISCORD_ALERTS_WEBHOOK=https://discord.com/api/webhooks/example/alerts
DISCORD_DIGEST_WEBHOOK=https://discord.com/api/webhooks/example/digest
GITHUB_TOKEN=gho_replace
STEAM_WEB_API_KEY=replace
GOOGLE_OAUTH_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace
GOOGLE_OAUTH_REFRESH_TOKEN=1//replace
# Refresh token must include both webmasters.readonly and analytics.readonly scopes.
GOOGLE_SERVICE_ACCOUNT={}
GSC_PROPERTIES=[]
GA4_PROPERTY_ID=
BING_WEBMASTER_API_KEY=
BING_PROPERTIES=[]
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ANALYTICS_SITE_TAGS={}
# Cloudflare Access service token for headless smoke checks against the
# deployed Worker (pnpm verify:deploy, pnpm smoke:ingest, pnpm smoke:cron
# when --base-url points at a remote URL). Create via Zero Trust dashboard
# > Access > Service Auth > Service Tokens, then add the token to the
# Access application's policy include list. Not required by the Worker
# itself; only the local CI/verify scripts read these.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
