{
  "name": "creator-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node --experimental-strip-types scripts/write-worker-wrapper.ts",
    "preview": "vite preview",
    "preview:local": "pnpm build && node --experimental-strip-types scripts/preview-local.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "migrate:local": "wrangler d1 migrations apply creator-dashboard --local",
    "migrate:remote": "wrangler d1 migrations apply creator-dashboard --remote",
    "deploy:preflight": "node --experimental-strip-types scripts/deploy-preflight.ts",
    "deploy:worker": "pnpm check && pnpm test && pnpm build && pnpm migrate:remote && wrangler deploy",
    "deploy": "pnpm deploy:preflight && pnpm deploy:worker",
    "dedup:metrics": "node --experimental-strip-types scripts/dedup-metric-points.ts",
    "backfill:events": "node --experimental-strip-types scripts/backfill-events.ts",
    "smoke:connectors": "node --experimental-strip-types scripts/smoke-connectors.ts",
    "smoke:public": "node --experimental-strip-types scripts/smoke-connectors.ts --public",
    "smoke:authenticated": "node --experimental-strip-types scripts/smoke-connectors.ts --authenticated",
    "smoke:cron": "node --experimental-strip-types scripts/smoke-cron.ts",
    "verify:deploy": "node --experimental-strip-types scripts/verify-deploy.ts",
    "kill:dev": "node --experimental-strip-types scripts/kill-dev.ts",
    "dev:setup": "node --experimental-strip-types scripts/dev-setup.ts"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  },
  "packageManager": "pnpm@11.28.8"
}
