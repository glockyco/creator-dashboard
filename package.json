{
  "name": "creator-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node --experimental-strip-types scripts/write-worker-wrapper.ts",
    "preview": "vite preview",
    "preview:local": "pnpm build && node --experimental-strip-types scripts/preview-local.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "migrate:local": "wrangler d1 migrations apply creator-dashboard --local",
    "migrate:remote": "wrangler d1 migrations apply creator-dashboard --remote",
    "sync-posts": "node --experimental-strip-types scripts/sync-posts.ts",
    "sync-posts:remote": "node --experimental-strip-types scripts/sync-posts.ts --execute-remote",
    "deploy:preflight": "node --experimental-strip-types scripts/deploy-preflight.ts",
    "deploy:worker": "pnpm migrate:remote && pnpm build && wrangler deploy",
    "deploy": "pnpm deploy:preflight && pnpm deploy:worker && pnpm sync-posts:remote",
    "backfill": "node --experimental-strip-types scripts/backfill-gsc.ts --execute-remote && node --experimental-strip-types scripts/backfill-bing.ts --execute-remote && node --experimental-strip-types scripts/backfill-cf.ts --execute-remote && node --experimental-strip-types scripts/backfill-ga4.ts --execute-remote",
    "dedup:metrics": "node --experimental-strip-types scripts/dedup-metric-points.ts",
    "smoke:connectors": "node --experimental-strip-types scripts/smoke-connectors.ts",
    "smoke:public": "node --experimental-strip-types scripts/smoke-connectors.ts --public",
    "smoke:authenticated": "node --experimental-strip-types scripts/smoke-connectors.ts --authenticated",
    "smoke:ingest": "node --experimental-strip-types scripts/smoke-ingest.ts",
    "smoke:cron": "node --experimental-strip-types scripts/smoke-cron.ts",
    "github:authorize": "node --experimental-strip-types scripts/github-oauth-authorize.ts",
    "verify:deploy": "node --experimental-strip-types scripts/verify-deploy.ts",
    "kill:dev": "node --experimental-strip-types scripts/kill-dev.ts",
    "dev:setup": "node --experimental-strip-types scripts/dev-setup.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.14.0",
    "@observablehq/plot": "latest",
    "bits-ui": "^2.18.1",
    "gray-matter": "latest",
    "jose": "latest",
    "vaul-svelte": "1.0.0-next.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@sveltejs/adapter-cloudflare": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-svelte": "latest",
    "globals": "^17.6.0",
    "prettier": "latest",
    "prettier-plugin-svelte": "latest",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.59.3",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "packageManager": "pnpm@10.0.0"
}
